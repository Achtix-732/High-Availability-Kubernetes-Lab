stages:
  - build
  - deploy

variables:
  IMAGE_NAME: 192.168.1.98:5050/achtix-homelab/currency-service:$CI_COMMIT_SHORT_SHA

# --- Stage 1: Build และ Push ขึ้น GitLab ---
build_job:
  stage: build
  image: docker:24.0.5
  variables:
    DOCKER_HOST: tcp://docker:2375
    DOCKER_TLS_CERTDIR: ""
  services:
    - name: docker:24.0.5-dind
      command: ["--insecure-registry=192.168.1.98:5050"]
  before_script:
    - export CI_REGISTRY="192.168.1.98:5050"
    - echo "Logging in to $CI_REGISTRY..."
    - echo "$CI_REGISTRY_PASSWORD" | docker login -u "$CI_REGISTRY_USER" --password-stdin $CI_REGISTRY
  script:
    - ls -la
    - docker build --platform linux/amd64 -t $IMAGE_NAME .
    - docker push $IMAGE_NAME

# --- Stage 2: Stage 2: Deploy to K8s ---
deploy_job:
  stage: deploy
  image: 
    name: bitnami/kubectl:latest
    entrypoint: [""]
  script:
    - if [ -z "$KUBE_CONFIG" ]; then echo "❌ KUBE_CONFIG is empty!"; exit 1; fi
    - echo "$KUBE_CONFIG" | base64 -d > kubeconfig.yaml
    # - ls -la kubeconfig.yaml
    # - find k8s/ -name "*.yaml" -exec sed -i "s|__IMAGE_NAME__|$IMAGE_NAME|g" {} +
    - kubectl --kubeconfig kubeconfig.yaml apply -f k8s/
    - kubectl --kubeconfig kubeconfig.yaml set image deployment/currency-deploy currency-deploy=$IMAGE_NAME
    - kubectl --kubeconfig kubeconfig.yaml rollout status deployment/currency-deploy
